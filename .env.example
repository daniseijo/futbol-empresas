# The site's focus team (slug from futbolempresas.es/equipo/<slug>/)
NEXT_PUBLIC_FOCUS_TEAM_SLUG=embat

# Public address of the site, for shared images and the sitemap (defaults to the Vercel one).
# NEXT_PUBLIC_SITE_URL=https://futbol-empresas.vercel.app

# Database. When unset, the local file data/futbol.db is used.
# In production (Vercel and GitHub Actions), the Turso one:
# DATABASE_URL=libsql://futbolempresas-<user>.turso.io
# DATABASE_AUTH_TOKEN=...

# The sync calls the site when it finishes so it refreshes its cache.
# REVALIDATE_URL=https://<your-domain>/api/revalidate
# REVALIDATE_SECRET=<long random string, the same in Vercel and GitHub>

# Call-ups for the focus team's matches (`pnpm notify`, see the README). Each channel is on when set.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-100...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# cron-job.org API key, for `pnpm cron-job` (the match-night cron, see the README).
# CRONJOB_API_KEY=...

# Logs the duration of every league API call to the console.
# SP_DEBUG=1
