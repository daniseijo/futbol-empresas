# Equipo principal de la web (slug de futbolempresas.es/equipo/<slug>/)
NEXT_PUBLIC_FOCUS_TEAM_SLUG=embat

# Base de datos. Sin definir, se usa el fichero local data/futbol.db.
# En producción (Vercel y GitHub Actions), la de Turso:
# DATABASE_URL=libsql://futbolempresas-<usuario>.turso.io
# DATABASE_AUTH_TOKEN=...

# La sincronización llama a la web al terminar para refrescar su caché.
# REVALIDATE_URL=https://<tu-dominio>/api/revalidate
# REVALIDATE_SECRET=<cadena aleatoria larga, la misma en Vercel y en GitHub>

# Registra en consola el tiempo de cada llamada a la API de la liga.
# SP_DEBUG=1
